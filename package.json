{
  "name": "setkamost",
  "version": "1.1.0",
  "description": "Expose your HTTP services over peer to peer connections with a friendly electron based graphical interface",
  "keywords": [
    "hypercore",
    "p2p",
    "proxy",
    "http"
  ],
  "homepage": "https://github.com/RangerMauve/setkamost#readme",
  "bugs": {
    "url": "https://github.com/RangerMauve/setkamost/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RangerMauve/setkamost.git"
  },
  "license": "MIT",
  "author": {
    "name": "RangerMauve",
    "email": "contact@mauve.moe"
  },
  "type": "module",
  "main": "src/proxy.js",
  "exports": {
    ".": "./src/proxy.js"
  },
  "bin": {
    "setkamost": "./bin/setkamost.js"
  },
  "files": [
    "src",
    "dist",
    "bin"
  ],
  "scripts": {
    "test": "node --test test/*.test.js && xvfb-run --auto-servernum npx electron --no-sandbox test/ui.js",
    "lint": "eslint --fix && tsc --noEmit",
    "start": "electron app/index.js"
  },
  "build": {
    "appId": "moe.mauve.setkamost",
    "productName": "Setkamost",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "src/**/*",
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "app/index.js"
    },
    "mac": {
      "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
      "target": [
        "deb",
        "AppImage",
        "apk",
        "pacman"
      ],
      "category": "Network;FileTransfer:P2P"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "hyper-http-fetch": "^1.0.3",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdht": "^6.34.0",
    "mime": "^4.1.0",
    "range-parser": "^1.3.0",
    "xdg-portable": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/range-parser": "^1.2.7",
    "@types/streamx": "^2.9.5",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
